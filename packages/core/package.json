{
  "name": "@infinite-dimensions-ai/research-telecom-big-data-analytics-core",
  "version": "0.1.0",
  "type": "module",
  "description": "Reproducible baseline experiment primitives for Telecommunications Big Data Analytics Research",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Infinite-Dimensions-AI/research-telecom-big-data-analytics.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@infinite-dimensions-ai/research-telecom-big-data-analytics-types": "workspace:^"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
